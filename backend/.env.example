DATABASE_URL=postgresql://postgres:12345@localhost:5432/career_compass_ai
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
CHATBOT_TIMEOUT_SECONDS=20
CHATBOT_MAX_TOKENS=700

# Vercel: set DATABASE_URL to the hosted provider's pooled PostgreSQL URL
# with TLS (sslmode=require). Vercel defaults DATABASE_AUTO_CREATE to false.
# Restore your existing database before deployment; do not run DDL per request.
# DATABASE_AUTO_CREATE=false
# Vercel: paste the complete service-account JSON as a server environment value.
# It takes precedence over FIREBASE_CREDENTIALS_PATH; keep it out of VITE_*.
# FIREBASE_CREDENTIALS_JSON=
# APP_SITE_URL=https://your-project.vercel.app
# YOUTUBE_API_KEY=
